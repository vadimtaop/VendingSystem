<Page x:Class="VendingSystemDesktop.Pages.VendingMachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VendingSystemDesktop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      d:DesignWidth="1000"
      Title="VendingMachinesPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="DimGray"
              Name="TopGrid">
            <TextBlock Text="Джутсу Вендинг"
                       FontSize="18"
                       Foreground="White"
                       Width="200"
                       HorizontalAlignment="Left"
                       Margin="20 0 0 0"/>
            <TextBlock Text="Администирование / Торговые автоматы"
                       FontSize="18"
                       Foreground="White"
                       Width="400"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       Margin="0 0 20 0"/>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Row="1">
            <TextBlock Text="Фильтр:"
                       FontSize="18"
                       Width="80"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 0"/>
            <TextBox Name="FilterTextBox"
                     FontSize="18"
                     Width="150"
                     HorizontalAlignment="Center"
                     Margin="0 0 0 0"
                     TextChanged="FilterTextChanged"/>
            <Button Content="Добавить"
                    FontSize="18"
                    Background="Transparent"
                    Width="100"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="AddButtonClick"/>
            <Button Content="Экспорт"
                    FontSize="18"
                    Background="Transparent"
                    Width="100"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="ExportButtonClick"/>
            <Button Content="Список/Плитка"
                    FontSize="18"
                    Background="Transparent"
                    Width="150"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="ListTypeButtonClick"/>
            <TextBlock Text="Кол-во ТА: 0"
                       Name="CountFilterTextBlock"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="10 0 0 0"/>
            <TextBlock Text="Кол-во общее: 0"
                       Name="CountTextBlock"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="10 0 0 0"/>
        </StackPanel>

        <DataGrid Name="VendingMachinesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="SlateGray"
                  Visibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding VendingMachineId}" MinWidth="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Company}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Модем" Binding="{Binding Modem}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Location}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Дата установки" Binding="{Binding InstallDate, StringFormat=d}" MinWidth="50" Width="*"/>
                <DataGridTemplateColumn MinWidth="100" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Button Content="Р"
                                        Background="Orange"
                                        Width="20"
                                        Height="20"
                                        Click="EditButtonClick"/>
                                <Button Content="У"
                                        Background="Red"
                                        Width="20"
                                        Height="20"
                                        Click="DeleteButtonClick"
                                        Margin="10 0 0 0"/>
                                <Button Content="О"
                                        Background="Transparent"
                                        Width="20"
                                        Height="20"
                                        Click="UnlinkButtonClick"
                                        Margin="10 0 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ListView Name="VendingMachinesListView"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                        BorderThickness="1">
                        <StackPanel Orientation="Vertical"
                                Width="300"
                                Height="90"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding VendingMachineId, StringFormat='Номер: {0}'}"/>
                            <TextBlock Text="{Binding Model, StringFormat='Модель: {0}'}"/>
                            <TextBlock Text="{Binding Modem, StringFormat='Модем: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <Button Content="Критическое"
                    FontSize="18"
                    Background="Transparent"
                    Width="250"
                    HorizontalAlignment="Center"
                    Click="CriticalMessageButtonClick"
                    Name="CriticalMessageButton"/>
            <Button Content="Предупреждающее"
                    FontSize="18"
                    Background="Transparent"
                    Width="250"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="WarningMessageButtonClick"
                    Name="WarningMessageButton"/>
            <Button Content="Информационное"
                    FontSize="18"
                    Background="Transparent"
                    Width="250"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="InfoMessageButtonClick"
                    Name="InfoMessageButton"/>

            <Popup Name="MessagePopup"
                   Margin="400 0 0 0"
                   Placement="Top"
                   PlacementTarget="{Binding ElementName=WarningMessageButton}">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            Name="MessageStackPanel">
                    <TextBlock Text="Уведомление"
                               Width="300"
                               Height="60"
                               Name="MessageTextBlock"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <Button Content="X"
                            Background="Transparent"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0 10 0 0"
                            BorderThickness="0"
                            Click="CloseMessageButtonClick"
                            Name="CloseMessageButton"/>
                </StackPanel>
            </Popup>
        </StackPanel>

    </Grid>
</Page>
