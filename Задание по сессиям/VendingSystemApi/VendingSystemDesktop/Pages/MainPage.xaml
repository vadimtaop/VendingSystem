<Page x:Class="VendingSystemDesktop.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VendingSystemDesktop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="DimGray">
            <TextBlock Text="Джутсу Вендинг"
                       FontSize="18"
                       Foreground="White"
                       Width="200"
                       HorizontalAlignment="Left"
                       Margin="20 0 0 0"/>
            <TextBlock Text="Главная"
                       FontSize="18"
                       Foreground="White"
                       Width="200"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       Margin="0 0 20 0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Images/diagrams1.png"
                   Grid.Column="0"
                   Margin="10"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image Source="/Images/diagrams2.png"
                       Grid.Row="0"
                       Margin="10"/>
                
                <Grid Grid.Row="1">
                    <DataGrid Margin="10"
                              Name="NewsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Date, StringFormat=d}" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                
            </Grid>

        </Grid>
        
    </Grid>
</Page>
