<Window x:Class="VendingSystemMobile.Windows.GeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VendingSystemMobile.Windows"
        mc:Ignorable="d"
        Title="Джутсу Вендинг"
        MinHeight="800"
        MinWidth="400"
        Height="800"
        Width="500"
        Background="GhostWhite"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/Logo.png"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="White"
              Name="TopGrid">
            <Image Source="/Images/Logo.png"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Height="65"/>
            
            <Button Content="Светлая тема"
                    Width="100"
                    Height="50"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Margin="20 0 0 0"
                    Click="WhiteThemeButtonClick"/>
            <Button Content="Темная тема"
                    Width="100"
                    Height="50"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0 0 20 0"
                    Background="Transparent"
                    Click="BlackThemeButtonClick"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Hidden"
                      Name="CenterScrollViewer"
                      Visibility="Visible">
            <Grid Grid.Row="1"
                  Background="GhostWhite"
                  Name="CenterGrid">
                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <ListView x:Name="VendingMachinesListView"
                              Background="GhostWhite">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1"
                                        BorderBrush="Black">
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="400">
                                        <TextBlock Text="{Binding VendingMachineId, StringFormat='Номер: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Location, StringFormat='Адрес: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding ServiceType, StringFormat='Тип обслуживания: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Model, StringFormat='Модель ТА: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding DeadlineDays, StringFormat='Срок выполнения (дн): {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusService, StringFormat='Статус обслуживания: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding StartServiceDate, StringFormat='Дата начала обслуживания: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Note, StringFormat='Заметка: {0}'}"
                                                   Height="30"
                                                   Width="400"
                                                   TextAlignment="Center"/>
                                        <Button Content="Принять"
                                                Width="150"
                                                Height="30"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                Click="ApplyButtonClick"/>
                                        <Button Content="Отклонить"
                                                Width="150"
                                                Height="30"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                Click="DeclineButtonClick"
                                                Margin="0 10 0 0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Name="KeepGrid"
              Background="GhostWhite"
              Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Заметка для заявки 0"
                           Name="TitleKeepTextBlock"
                           FontSize="24"
                           HorizontalAlignment="Center"/>
                <TextBox Margin="0 10 0 0"
                         Name="KeepTextBox"
                         Width="400"
                         Height="450"
                         TextWrapping="Wrap"/>
                <Button Content="Сохранить"
                        Width="300"
                        Height="30"
                        BorderThickness="1"
                        Background="Transparent"
                        Margin="0 10 0 0"
                        Click="SaveButtonClick"/>
                <Button Content="Отменить"
                        Width="300"
                        Height="30"
                        BorderThickness="1"
                        Background="Transparent"
                        Margin="0 10 0 0"
                        Click="CancelButtonClick"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Name="CancelGrid"
              Background="GhostWhite"
              Visibility="Collapsed">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Причина отказа"
                           FontSize="24"
                           HorizontalAlignment="Center"/>
                <TextBox Margin="0 10 0 0"
                         Name="CancelTextBox"
                         Width="400"
                         Height="450"
                         TextWrapping="Wrap"/>
                <Button Content="Подтвердить"
                        Width="300"
                        Height="30"
                        BorderThickness="1"
                        Background="Transparent"
                        Margin="0 10 0 0"
                        Click="ConfirmButtonClick"/>
                <Button Content="Назад"
                        Width="300"
                        Height="30"
                        BorderThickness="1"
                        Background="Transparent"
                        Margin="0 10 0 0"
                        Click="BackButtonClick"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Background="White"
              Name="BottomGrid">
            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Row="2">
                <Button Content="Камера"
                        Width="100"
                        Height="50"
                        BorderThickness="1"
                        Background="Transparent"
                        Click="CameraButtonClick"/>
                <Button Content="Видео"
                        Width="100"
                        Height="50"
                        BorderThickness="1"
                        Background="Transparent"
                        Click="CameraButtonClick"/>
                <Button Content="Заметка"
                        Width="100"
                        Height="50"
                        BorderThickness="1"
                        Background="Transparent"
                        Click="KeepButtonClick"/>
                <Button Content="Мои отчеты"
                        Width="100"
                        Height="50"
                        BorderThickness="1"
                        Background="Transparent"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
