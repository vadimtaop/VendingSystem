<Window x:Class="VendingSystemWeb.Windows.GeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VendingSystemWeb.Windows"
        mc:Ignorable="d"
        Title="GeneralWindow"
        MinHeight="800"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/Logo.png"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Height="75"/>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Row="1">
            <Button Content="Торговые автоматы"
                    Width="200"
                    Height="30"
                    BorderThickness="1"
                    Background="Transparent"
                    Click="VendingMachinesButtonClick"/>
            <Button Content="Календарь обслуживания"
                    Width="200"
                    Height="30"
                    BorderThickness="1"
                    Background="Transparent"
                    Click="CalendarButtonClick"
                    Margin="20 0 0 0"/>
            <Button Content="График работ"
                    Width="200"
                    Height="30"
                    BorderThickness="1"
                    Background="Transparent"
                    Click="ScheduleButtonClick"
                    Margin="20 0 0 0"/>
        </StackPanel>

        <Frame Name="MainFrame"
               Source="../Pages/MainPage.xaml"
               Grid.Row="2"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
