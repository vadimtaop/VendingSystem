<Page x:Class="VendingSystemWeb.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VendingSystemWeb.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800"
      d:DesignWidth="800"
      Title="CalendarPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
            <TextBlock Text="Фильтр:"
                       FontSize="18"
                       Width="80"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 0"/>
            <TextBox Name="FilterTextBox"
                     FontSize="18"
                     Width="150"
                     HorizontalAlignment="Center"
                     Margin="0 0 0 0"
                     TextChanged="FilterTextChanged"/>
            <Button Content="Расчитать следующее обслуживание"
                    FontSize="18"
                    Background="Transparent"
                    Width="400"
                    HorizontalAlignment="Center"
                    Margin="20 0 0 0"
                    Click="CalcButtonClick"/>
        </StackPanel>

        <DataGrid Name="VendingMachinesDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AlternatingRowBackground="SlateGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding VendingMachineId}" MinWidth="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Company}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Модем" Binding="{Binding Modem}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Location}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Дата установки" Binding="{Binding InstallDate, StringFormat=d}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Интервал (мес.)" Binding="{Binding IntervalService}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Дата след. обслуживания" Binding="{Binding NextServiceDate, StringFormat=d}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Статус ТА" Binding="{Binding StatusMachine}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Статус обслуж" Binding="{Binding StatusService}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding NameUser}" MinWidth="50" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" MinWidth="50" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</Page>
